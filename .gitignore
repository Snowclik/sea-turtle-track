# ==============================================================================
# Git Ignore — Sea Turtle Track Project
# ==============================================================================

# Entornos virtuales
venv/
env/
.venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook
.ipynb_checkpoints

# Logs
logs/
*.log

# Variables de entorno y secretos sensibles
.env
.env.*
*.env
*.env.*
*.pem
*.key
*.cert
*.secret

# Entorno de usuario y SO
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node / Frontend (Tauri Desktop App)
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.local

# Tauri / Rust
target/
**/target/
src-tauri/target/
**/src-tauri/target/

# Datos pesados de entrenamiento local (imágenes sin comprimir)
dataset/original/
dataset/labels/
dataset/synthetic/
dataset/validation/
dataset/test/
dataset/preview/
dataset/splits/
datasets/

# Experimentos y modelos de benchmark en raíz
/models/
experiments/
yolo11n.pt
yolo11n.onnx
yolov5nu.pt
yolov5nu.onnx
yolov8n.pt
yolov8n.onnx
yolo26n-seg.pt

# Archivos multimedia de prueba pesados
*.mp4
*.avi
*.mov
*.mkv

# Reportes generados (excepto .gitkeep)
reports/
!reports/.gitkeep

# Copias temporales
* copy/
* copy*/
